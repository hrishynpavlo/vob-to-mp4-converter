@page "/"
@using FFMpegCore.Enums
@using FFMpegCore.Pipes
@using Serilog
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject FileValidator FileValidator

<PageTitle>VOB to MP4 Converter</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-body p-5">
                    <div class="mb-5">
                        <label class="form-label fw-bold">Select VOB Files (max 5)</label>
                        <InputFile OnChange="OnInputFileChange" class="form-control" accept=".vob" multiple disabled="@isConverting" />
                        
                        @if (selectedFiles.Any())
                        {
                            <div class="mt-3">
                                <strong>Selected files (@selectedFiles.Count):</strong>
                                <ul class="list-group mt-2">
                                    @foreach (var file in selectedFiles)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-file-earmark-play"></i> @file.Name</span>
                                            <span class="badge bg-secondary">@FormatFileSize(file.Size)</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    @if (isConverting)
                    {
                        <div class="conversion-progress mb-5">
                            <div class="progress mb-2" style="height: 30px;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" 
                                     role="progressbar" 
                                     style="width: 100%">
                                    @currentTimeStamp
                                </div>
                            </div>

                            <div class="text-center text-muted">
                                <div class="spinner-border spinner-border-sm me-2" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <span>@statusMessage</span>
                            </div>
                        </div>
                    }

                    <div class="d-grid">
                        <button @onclick="ConvertVideo" class="btn btn-primary btn-lg" 
                                disabled="@(!selectedFiles.Any() || isConverting || validationErrors.Any())">
                            <i class="bi bi-arrow-repeat"></i> Convert @(selectedFiles.Count > 0 ? $"{selectedFiles.Count} File(s)" : "") to MP4
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
                        </div>
                    }

                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Validation Errors:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>
                                        @if (!string.IsNullOrEmpty(error.FileName))
                                        {
                                            <strong>@error.FileName:</strong>
                                        }
                                        @error.Message
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (conversionCompleted && conversionStats != null)
                    {
                        <div class="alert alert-success mt-4" role="alert">
                            <h5 class="alert-heading mb-3">
                                <i class="bi bi-check-circle-fill"></i> Conversion Completed Successfully!
                            </h5>
                            <hr>
                            <div class="conversion-stats">
                                <div class="stat-row">
                                    <span class="stat-label"><i class="bi bi-clock-history"></i> Conversion Time:</span>
                                    <span class="stat-value">@conversionStats.ConversionTime</span>
                                </div>
                                <div class="stat-row">
                                    <span class="stat-label"><i class="bi bi-play-circle"></i> Video Duration:</span>
                                    <span class="stat-value">@conversionStats.VideoDuration</span>
                                </div>
                                <div class="stat-row">
                                    <span class="stat-label"><i class="bi bi-file-earmark"></i> Original Size:</span>
                                    <span class="stat-value">@conversionStats.OriginalSize</span>
                                </div>
                                <div class="stat-row">
                                    <span class="stat-label"><i class="bi bi-file-earmark-zip"></i> Converted Size:</span>
                                    <span class="stat-value">@conversionStats.ConvertedSize</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
        </div>
</div>

@code {
    private List<IBrowserFile> selectedFiles = new();
    private List<ValidationError> validationErrors = new();
    private bool isConverting = false;
    private string statusMessage = "Starting conversion...";
    private string errorMessage = string.Empty;
    private string currentTimeStamp = "00:00:00";
    private bool conversionCompleted = false;
    private ConversionStats? conversionStats = null;
    
    private void OnInputFileChange(InputFileChangeEventArgs e)
    {
        if (e.FileCount > 5)
        {
            ResetStateWithError("You can upload a maximum of 5 files at a time.");
            return;
        }

        var files = e.GetMultipleFiles(5);
        var results = FileValidator.Validate(files);
        validationErrors = results
            .Where(x => x.Value.IsOk is false)
            .Select(x => new ValidationError(x.Key, x.Value.Error!.Description))
            .ToList();

        if (validationErrors.Any())
        {
            selectedFiles.Clear();
            errorMessage = "Validation failed. See errors below.";
            conversionCompleted = false;
            conversionStats = null;
        }
        else
        {
            selectedFiles = files.ToList();
            errorMessage = string.Empty;
            validationErrors.Clear();
            conversionCompleted = false;
            conversionStats = null;
        }
    }

    private async Task ConvertVideo()
    {
        if (!selectedFiles.Any()) return;

        isConverting = true;
        statusMessage = "Starting conversion...";
        errorMessage = string.Empty;
        currentTimeStamp = "00:00:00";
        conversionCompleted = false;
        conversionStats = null;
        StateHasChanged();

        // TODO: Process all files in queue
        var selectedFile = selectedFiles.First(); 
        var startTime = DateTime.UtcNow;
        TimeSpan videoDuration = TimeSpan.Zero;
        long originalSize = selectedFile.Size;

        try
        {
            var path = Path.Combine(Path.GetTempPath(), selectedFile.Name);
            await using var inputStream = selectedFile.OpenReadStream(selectedFile.Size);
            var outPath = Path.ChangeExtension(path, ".mp4");
            
            var ffmpegArgs = FFMpegArguments
                .FromPipeInput(new StreamPipeSource(inputStream))
                .OutputToFile(outPath)
                .NotifyOnProgress(ts =>
                {
                    InvokeAsync(() =>
                    {
                        currentTimeStamp = ts.ToString(@"hh\:mm\:ss");
                        statusMessage = $"Processing... {currentTimeStamp}";
                        videoDuration = ts;
                        StateHasChanged();
                    });
                });

            statusMessage = "Processing video...";
            StateHasChanged();

            var ffmpegResult = await ffmpegArgs
                .ProcessAsynchronously(throwOnError: true, ffMpegOptions: new FFOptions
                {
                    LogLevel = FFMpegLogLevel.Verbose,
                    BinaryFolder = Path.Combine(AppContext.BaseDirectory, "ffmpeg")
                });

            statusMessage = "Reading converted file...";
            StateHasChanged();

            var data = await File.ReadAllBytesAsync(outPath);
            long convertedSize = data.Length;
            
            statusMessage = "Downloading...";
            StateHasChanged();
            
            await JS.InvokeVoidAsync("downloadFile", data, "video/mp4", Path.ChangeExtension(selectedFile.Name, ".mp4"));
            
            File.Delete(outPath);

            var endTime = DateTime.UtcNow;
            var conversionTime = endTime - startTime;

            conversionStats = new ConversionStats
            {
                ConversionTime = FormatTimeSpan(conversionTime),
                VideoDuration = FormatTimeSpan(videoDuration),
                OriginalSize = FormatFileSize(originalSize),
                ConvertedSize = FormatFileSize(convertedSize)
            };

            conversionCompleted = true;
            statusMessage = "Conversion completed!";
            Log.Logger.Information("Conversion completed successfully for file: {fileName}", selectedFile.Name);
        }
        catch (Exception ex)
        {
            Log.Logger.Error(ex, "Conversion failed for file: {fileName}", selectedFile?.Name);
            errorMessage = $"Conversion failed: {ex.Message}";
            statusMessage = "Conversion failed";
        }
        finally
        {
            isConverting = false;
            currentTimeStamp = "00:00:00";
            StateHasChanged();
        }
    }

    private void ResetStateWithError(string displayError)
    {
        selectedFiles.Clear();
        validationErrors.Clear();
        errorMessage = displayError;
        conversionCompleted = false;
        conversionStats = null;
    }

    private record ValidationError(string FileName, string Message);

}