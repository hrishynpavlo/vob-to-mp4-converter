@page "/"
@using FFMpegCore.Enums
@using FFMpegCore.Pipes
@using Serilog
@using VobToMp4.Models
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject FileValidator FileValidator
@inject DownloadManager DownloadManager

<PageTitle>VOB to MP4 Converter</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-body p-5">
                    <div class="mb-5">
                        <label class="form-label fw-bold">Select VOB Files (max 10)</label>
                        <InputFile OnChange="OnInputFileChange" class="form-control" accept=".vob" multiple disabled="@isConverting" />
                        
                        @if (conversionItems.Any())
                        {
                            <div class="mt-3">
                                <strong>Selected files (@conversionItems.Count):</strong>
                                <ul class="list-group mt-2">
                                    @foreach (var item in conversionItems)
                                    {
                                        <li class="list-group-item @GetListItemClass(item.Status)">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span>
                                                    <i class="@GetStatusIcon(item.Status)"></i> @item.FileName
                                                    <span class="badge bg-secondary ms-2">@FormatFileSize(item.OriginalSize)</span>
                                                </span>
                                                <span class="d-flex align-items-center gap-2">
                                                    @if (item.Status == FileConversionStatus.Completed)
                                                    {
                                                        <span class="text-muted small">@FormatFileSize(item.ConvertedSize)</span>
                                                    }
                                                    <span class="badge @GetStatusBadgeClass(item.Status)">@GetStatusText(item)</span>
                                                    <button class="btn btn-success btn-sm" 
                                                            disabled="@(item.Status != FileConversionStatus.Completed)"
                                                            @onclick="() => DownloadFile(item)">
                                                        <i class="bi bi-download"></i> Download
                                                    </button>
                                                </span>
                                            </div>

                                            @if (item.Status == FileConversionStatus.Converting)
                                            {
                                                <div class="progress mt-2" style="height: 20px;">
                                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success"
                                                         role="progressbar"
                                                         style="width: 100%">
                                                        @item.CurrentTimestamp
                                                    </div>
                                                </div>
                                            }

                                            @if (item.Status is FileConversionStatus.Converting or FileConversionStatus.ReadingOutput)
                                            {
                                                <div class="text-muted small mt-1">
                                                    <div class="spinner-border spinner-border-sm me-1" role="status">
                                                        <span class="visually-hidden">Loading...</span>
                                                    </div>
                                                    @item.StatusMessage
                                                </div>
                                            }

                                            @if (item.Status == FileConversionStatus.Completed)
                                            {
                                                <div class="small text-muted mt-1">
                                                    <i class="bi bi-clock-history"></i> @FormatTimeSpan(item.ConversionTime)
                                                    <span class="ms-2"><i class="bi bi-play-circle"></i> @FormatTimeSpan(item.VideoDuration)</span>
                                                </div>
                                            }

                                            @if (item.Status == FileConversionStatus.Failed)
                                            {
                                                <div class="text-danger small mt-1">
                                                    <i class="bi bi-exclamation-triangle-fill"></i> @item.ErrorMessage
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    <div class="d-grid">
                        <button @onclick="ConvertAllFiles" class="btn btn-primary btn-lg" 
                                disabled="@(!conversionItems.Any() || isConverting || validationErrors.Any())">
                            <i class="bi bi-arrow-repeat"></i> Convert @(conversionItems.Count > 0 ? $"{conversionItems.Count} File(s)" : "") to MP4
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i> @errorMessage
                        </div>
                    }

                    @if (validationErrors.Any())
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            <h6 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Validation Errors:</h6>
                            <ul class="mb-0">
                                @foreach (var error in validationErrors)
                                {
                                    <li>
                                        @if (!string.IsNullOrEmpty(error.FileName))
                                        {
                                            <strong>@error.FileName:</strong>
                                        }
                                        @error.Message
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
        </div>
</div>

@code {
    private List<IBrowserFile> selectedFiles = new();
    private List<ValidationError> validationErrors = new();
    private List<FileConversionItem> conversionItems = new();
    private bool isConverting;
    private string errorMessage = string.Empty;
    
    private void OnInputFileChange(InputFileChangeEventArgs e)
    {
        if (e.FileCount > 10)
        {
            ResetStateWithError("You can upload a maximum of 10 files at a time.");
            return;
        }

        var files = e.GetMultipleFiles(10);
        var results = FileValidator.Validate(files);
        validationErrors = results
            .Where(x => x.Value.IsOk is false)
            .Select(x => new ValidationError(x.Key, x.Value.Error!.Description))
            .ToList();

        if (validationErrors.Any())
        {
            selectedFiles.Clear();
            errorMessage = "Validation failed. See errors below.";
            conversionItems.Clear();
        }
        else
        {
            selectedFiles = files.ToList();
            errorMessage = string.Empty;
            validationErrors.Clear();
            conversionItems = selectedFiles
                .Select(f => new FileConversionItem { BrowserFile = f })
                .ToList();
        }
    }

    private async Task ConvertAllFiles()
    {
        if (!conversionItems.Any()) return;

        isConverting = true;
        errorMessage = string.Empty;

        foreach (var item in conversionItems)
        {
            item.Status = FileConversionStatus.Pending;
            item.StatusMessage = "Waiting...";
            item.ErrorMessage = null;
            item.CurrentTimestamp = "00:00:00";
        }
        StateHasChanged();

        foreach (var item in conversionItems)
        {
            await ConvertSingleFile(item);
            StateHasChanged();
        }

        isConverting = false;
        StateHasChanged();
    }

    private async Task ConvertSingleFile(FileConversionItem item)
    {
        var startTime = DateTime.UtcNow;

        try
        {
            item.Status = FileConversionStatus.Converting;
            item.StatusMessage = "Starting conversion...";
            StateHasChanged();

            var path = Path.Combine(Path.GetTempPath(), item.FileName);
            await using var inputStream = item.BrowserFile.OpenReadStream(item.BrowserFile.Size);
            var outPath = Path.ChangeExtension(path, ".mp4");

            var ffmpegArgs = FFMpegArguments
                .FromPipeInput(new StreamPipeSource(inputStream))
                .OutputToFile(outPath)
                .NotifyOnProgress(ts =>
                {
                    InvokeAsync(() =>
                    {
                        item.CurrentTimestamp = ts.ToString(@"hh\:mm\:ss");
                        item.StatusMessage = $"Processing... {item.CurrentTimestamp}";
                        item.VideoDuration = ts;
                        StateHasChanged();
                    });
                });

            item.StatusMessage = "Processing video...";
            StateHasChanged();

            await ffmpegArgs.ProcessAsynchronously(throwOnError: true, ffMpegOptions: new FFOptions
            {
                LogLevel = FFMpegLogLevel.Verbose,
                BinaryFolder = Path.Combine(AppContext.BaseDirectory, "ffmpeg")
            });

            item.Status = FileConversionStatus.ReadingOutput;
            item.StatusMessage = "Finalizing...";
            StateHasChanged();

            var fileInfo = new FileInfo(outPath);
            item.ConvertedSize = fileInfo.Length;
            item.OutputPath = outPath;
            item.ConversionTime = DateTime.UtcNow - startTime;

            item.Status = FileConversionStatus.Completed;
            item.StatusMessage = "Completed!";
            Log.Logger.Information("Conversion completed successfully for file: {FileName}", item.FileName);
        }
        catch (Exception ex)
        {
            Log.Logger.Error(ex, "Conversion failed for file: {FileName}", item.FileName);
            item.Status = FileConversionStatus.Failed;
            item.ErrorMessage = $"Conversion failed: {ex.Message}";
            item.StatusMessage = "Failed";
        }
    }

    private async Task DownloadFile(FileConversionItem item)
    {
        if (item.OutputPath is null || !File.Exists(item.OutputPath)) return;

        var mp4Name = Path.ChangeExtension(item.FileName, ".mp4");
        var token = DownloadManager.Register(item.OutputPath, mp4Name);
        await JS.InvokeVoidAsync("triggerDownload", $"/api/download/{token}", mp4Name);
    }

    private void ResetStateWithError(string displayError)
    {
        selectedFiles.Clear();
        validationErrors.Clear();
        conversionItems.Clear();
        errorMessage = displayError;
    }

    private static string GetListItemClass(FileConversionStatus status) => status switch
    {
        FileConversionStatus.Converting => "list-group-item-primary",
        FileConversionStatus.ReadingOutput => "list-group-item-info",
        FileConversionStatus.Completed => "list-group-item-success",
        FileConversionStatus.Failed => "list-group-item-danger",
        _ => ""
    };

    private static string GetStatusText(FileConversionItem item) => item.Status switch
    {
        FileConversionStatus.Ready => "Ready",
        FileConversionStatus.Pending => "Pending",
        FileConversionStatus.Converting => item.CurrentTimestamp,
        FileConversionStatus.ReadingOutput => "Finalizing",
        FileConversionStatus.Completed => "Done",
        FileConversionStatus.Failed => "Failed",
        _ => ""
    };

    private static string GetStatusBadgeClass(FileConversionStatus status) => status switch
    {
        FileConversionStatus.Ready => "bg-secondary",
        FileConversionStatus.Pending => "bg-secondary",
        FileConversionStatus.Converting => "bg-primary",
        FileConversionStatus.ReadingOutput => "bg-info",
        FileConversionStatus.Completed => "bg-success",
        FileConversionStatus.Failed => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetStatusIcon(FileConversionStatus status) => status switch
    {
        FileConversionStatus.Ready => "bi bi-file-earmark-play",
        FileConversionStatus.Pending => "bi bi-hourglass",
        FileConversionStatus.Converting => "bi bi-gear-fill",
        FileConversionStatus.ReadingOutput => "bi bi-file-earmark-arrow-down",
        FileConversionStatus.Completed => "bi bi-check-circle-fill text-success",
        FileConversionStatus.Failed => "bi bi-x-circle-fill text-danger",
        _ => "bi bi-file-earmark"
    };

    private record ValidationError(string FileName, string Message);

}